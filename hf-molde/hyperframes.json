    },
    {
      "name": "chromatic-aberration-wipe",
      "type": "hyperframes:component",
      "target": "compositions/components/chromatic-aberration-wipe.html"
    },
    {
      "name": "device-frame-stage",
      "type": "hyperframes:component",
      "target": "compositions/components/device-frame-stage.html"
    }
  ]
}
